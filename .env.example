# ==============================================================================
# TEMPLATE KONFIGURASI ENVIRONMENT - SISTEM POS EVENT 2026
# ==============================================================================
# Petunjuk: Salin file ini menjadi .env sebelum menjalankan aplikasi:
#   Windows (PowerShell/CMD) : copy .env.example .env
#   Linux / macOS            : cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma / MySQL via Laragon / VPS)
# ------------------------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Default Laragon: user 'root', password kosong (''), port 3306
DATABASE_URL="mysql://root:@localhost:3306/pos_system"

# ------------------------------------------------------------------------------
# 2. KEAMANAN & AUTENTIKASI (JWT)
# ------------------------------------------------------------------------------
# [PENTING]: Ganti dengan string acak yang panjang dan aman saat mode produksi!
JWT_SECRET="pos_system_jwt_secret_key_super_secure_csm_2026"

# ------------------------------------------------------------------------------
# 3. SERVER & NETWORKING
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. FITUR STAN KIOSK & SUPERVISOR
# ------------------------------------------------------------------------------
# PIN Supervisor untuk akses modal sensitif di layar Kiosk (Tutup Stan / VOID / Edit Menu)
SUPERVISOR_PIN="8888"

# ------------------------------------------------------------------------------
# 5. KONSOLIDASI & SINKRONISASI MULTI-NODE (FLEET SYNC)
# ------------------------------------------------------------------------------
# Kunci otorisasi sinkronisasi data transaksi antar-laptop Kiosk dan Server Pusat
SYNC_SECRET="csm_fleet_sync_pass_2026"

# ------------------------------------------------------------------------------
# 6. OPTIONAL DEVELOPER SETTINGS
# ------------------------------------------------------------------------------
# Set 'true' jika ingin mematikan Hot Module Reload (HMR) pada perangkat spesifikasi rendah
# DISABLE_HMR=false
